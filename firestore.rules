rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function validProfile(data) {
      return data.keys().hasOnly(['uid','username','createdAt']) && self(data.uid)
        && data.username is string && data.username.matches('[a-z][a-z0-9_]{2,19}') && data.createdAt == request.time;
    }
    match /handles/{name} {
      allow read: if signedIn();
      allow create: if validProfile(request.resource.data) && request.resource.data.username == name
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username == name;
      allow delete: if self(resource.data.uid)
        && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username == name
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username != name;
    }
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if self(uid) && validProfile(request.resource.data) && request.resource.data.uid == uid
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.username)).data.uid == uid;
      allow update: if self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && request.resource.data.username is string && request.resource.data.username.matches('[a-z][a-z0-9_]{2,19}')
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.username)).data.uid == uid
        && !existsAfter(/databases/$(database)/documents/handles/$(resource.data.username));
    }
    match /friendRequests/{id} {
      function participant() {return signedIn() && (resource.data.recipient == request.auth.uid || resource.data.requester == request.auth.uid);}
      allow list, delete: if participant();
      allow get: if signedIn() && (id.matches(request.auth.uid+'~.*') || id.matches('.*~'+request.auth.uid));
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['requester','recipient','status','createdAt','updatedAt'])
        && request.resource.data.requester == request.auth.uid && request.resource.data.recipient is string
        && request.resource.data.recipient != request.auth.uid && id == request.auth.uid+'~'+request.resource.data.recipient
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.recipient))
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.recipient == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status == 'accepted' && request.resource.data.updatedAt == request.time;
    }
    match /friendships/{owner}/friends/{friend} {
      allow read: if self(owner);
      function accepted() {
        let data=request.resource.data;
        let invitation=getAfter(/databases/$(database)/documents/friendRequests/$(data.requestId)).data;
        let mirror=getAfter(/databases/$(database)/documents/friendships/$(friend)/friends/$(owner)).data;
        return data.keys().hasOnly(['owner','friend','requestId','createdAt']) && owner != friend && data.owner == owner && data.friend == friend
          && data.createdAt == request.time && invitation.status == 'accepted' && invitation.recipient == request.auth.uid
          && ((invitation.recipient == owner && invitation.requester == friend) || (invitation.requester == owner && invitation.recipient == friend))
          && mirror.owner == friend && mirror.friend == owner && mirror.requestId == data.requestId;
      }
      allow create: if signedIn() && accepted();
      allow delete: if self(owner) || self(friend);
    }
    function score(value) {return value == null || value is number && value >= 0 && value <= 10;}
    function validAppearance(data) {
      return data.get('planet','happy') in ['happy','sad','party','fire','sun','love','wow','sleepy','strong','rocket','martian','distorted','laughing','crying','angry','thinking','wink','salute','grateful','melting','nerd','kiss','mogging']
        && data.get('vibes','') is string && data.get('vibes','').size() <= 160
        && data.get('vibesVersion','legacy-version') is string && data.get('vibesVersion','legacy-version').matches('[A-Za-z0-9_-]{8,64}');
    }
    function validSummary(uid) {
      return self(uid)
        && request.resource.data.keys().hasOnly(['uid','username','appDate','month','yesterdayDate','yesterdayScore','monthScore','daysLogged','totalDaysLogged','updatedAt','planet','vibes','vibesVersion','consecutiveStreak','streakEndDate'])
        && validAppearance(request.resource.data)
        && request.resource.data.uid == uid && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(uid)).data.username
        && request.resource.data.appDate is string && request.resource.data.appDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.month is string && request.resource.data.month.matches('[0-9]{4}-[0-9]{2}') && request.resource.data.appDate.matches(request.resource.data.month+'-[0-9]{2}')
        && request.resource.data.yesterdayDate is string && request.resource.data.yesterdayDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && score(request.resource.data.yesterdayScore) && score(request.resource.data.monthScore)
        && request.resource.data.daysLogged is int && request.resource.data.daysLogged >= 0 && request.resource.data.daysLogged <= 31
        && request.resource.data.totalDaysLogged is int && request.resource.data.totalDaysLogged >= request.resource.data.daysLogged && request.resource.data.totalDaysLogged <= 20000
        && request.resource.data.get('consecutiveStreak',0) is int && request.resource.data.get('consecutiveStreak',0) >= 0
        && request.resource.data.get('consecutiveStreak',0) <= request.resource.data.totalDaysLogged
        && (request.resource.data.get('consecutiveStreak',0) == 0 && request.resource.data.get('streakEndDate',null) == null
          || request.resource.data.get('consecutiveStreak',0) > 0 && request.resource.data.get('streakEndDate',null) in [request.resource.data.appDate,request.resource.data.yesterdayDate])
        && request.resource.data.updatedAt == request.time;
    }
    match /socialScores/{uid} {
      allow read: if self(uid) || signedIn() && exists(/databases/$(database)/documents/friendships/$(uid)/friends/$(request.auth.uid));
      allow create, update: if validSummary(uid) && !request.resource.data.keys().hasAny(['planet','vibes','vibesVersion']);
    }
    function member(group,uid) {return exists(/databases/$(database)/documents/friendGroups/$(group)/members/$(uid)) && get(/databases/$(database)/documents/friendGroups/$(group)).data.get('deletedAt',null) == null;}
    function owner(group) {return signedIn() && get(/databases/$(database)/documents/friendGroups/$(group)).data.owner == request.auth.uid;}
    function groupData(group) {return getAfter(/databases/$(database)/documents/friendGroups/$(group)).data;}
    function admission(group,uid) {
      let invitation=get(/databases/$(database)/documents/groupRequests/$(group+'~'+uid)).data;
      return invitation.groupId == group && invitation.userId == uid && invitation.owner == groupData(group).owner
        && ((invitation.kind == 'join' && owner(group)) || (invitation.kind == 'invite' && self(uid)))
        && !existsAfter(/databases/$(database)/documents/groupRequests/$(group+'~'+uid));
    }
    function mayAdmit(group,uid) {return signedIn() && groupData(group).get('deletedAt',null) == null && ((self(uid) && groupData(group).owner == uid) || admission(group,uid));}
    function mayRemove(group,uid) {
      return signedIn() && groupData(group).owner != uid && (self(uid) || owner(group))
        && !existsAfter(/databases/$(database)/documents/friendGroups/$(group)/members/$(uid))
        && !existsAfter(/databases/$(database)/documents/groupMemberships/$(uid)/groups/$(group))
        && !existsAfter(/databases/$(database)/documents/friendGroups/$(group)/scores/$(uid));
    }
    match /friendGroups/{group} {
      allow get: if signedIn();
      allow update: if owner(group) && resource.data.get('deletedAt',null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 40
        && getAfter(/databases/$(database)/documents/groupDirectory/$(group)).data.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/groupDirectory/$(group)).data.searchName == request.resource.data.name.lower();
      allow update: if owner(group) && resource.data.get('deletedAt',null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt']) && request.resource.data.deletedAt == request.time
        && !existsAfter(/databases/$(database)/documents/groupDirectory/$(group))
        && !existsAfter(/databases/$(database)/documents/solarOwnership/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/groupMemberships/$(request.auth.uid)/groups/$(group));
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name','owner','ownerUsername','createdAt'])
        && !exists(/databases/$(database)/documents/solarOwnership/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/solarOwnership/$(request.auth.uid)).data.groupId == group
        && self(request.resource.data.owner) && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 40
        && request.resource.data.ownerUsername == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/groupDirectory/$(group)).data.name == request.resource.data.name
        && existsAfter(/databases/$(database)/documents/friendGroups/$(group)/members/$(request.auth.uid));
      match /members/{uid} {
        allow read: if signedIn() && (member(group,request.auth.uid) || owner(group));
        allow create: if mayAdmit(group,uid) && request.resource.data.keys().hasOnly(['uid','username','joinedAt'])
          && request.resource.data.uid == uid && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(uid)).data.username
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/groupMemberships/$(uid)/groups/$(group)).data.groupId == group;
        allow delete: if mayRemove(group,uid);
      }
      match /scores/{uid} {
        allow read: if signedIn() && member(group,request.auth.uid);
        allow create,update: if member(group,uid) && validSummary(uid);
        allow delete: if mayRemove(group,uid);
      }
      match /days/{id} {
        allow read: if signedIn() && member(group,request.auth.uid);
        allow create,update: if signedIn() && member(group,request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid','username','date','score','reviewComplete','updatedAt'])
          && request.resource.data.get('reviewComplete',false) is bool
          && self(request.resource.data.uid) && id == request.auth.uid+'~'+request.resource.data.date
          && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username
          && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.score is number && score(request.resource.data.score) && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && member(group,request.auth.uid) && self(resource.data.uid);
      }
      match /reactions/{id} {
        allow read: if signedIn() && member(group,request.auth.uid);
        allow create,update: if signedIn() && member(group,request.auth.uid)
          && request.resource.data.keys().hasOnly(['target','date','reactor','username','kind','updatedAt'])
          && self(request.resource.data.reactor) && request.resource.data.target != request.auth.uid
          && member(group,request.resource.data.target)
          && id == request.resource.data.target+'~'+request.resource.data.date+'~'+request.auth.uid
          && exists(/databases/$(database)/documents/friendGroups/$(group)/days/$(request.resource.data.target+'~'+request.resource.data.date))
          && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username
          && request.resource.data.kind in ['happy','sad','party','fire','sun','love','wow','sleepy','strong','rocket','martian','distorted','laughing','crying','angry','thinking','wink','salute','grateful','melting','nerd','kiss','mogging'] && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && member(group,request.auth.uid) && (self(resource.data.reactor) || owner(group));
      }
      match /vibeReactions/{id} {
        allow read: if signedIn() && member(group,request.auth.uid);
        allow create,update: if signedIn() && member(group,request.auth.uid)
          && request.resource.data.keys().hasOnly(['target','reactor','username','version','kind','updatedAt'])
          && self(request.resource.data.reactor) && request.resource.data.target != request.auth.uid
          && member(group,request.resource.data.target)
          && id == request.resource.data.target+'~'+request.auth.uid
          && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username
          && get(/databases/$(database)/documents/friendGroups/$(group)/scores/$(request.resource.data.target)).data.get('vibes','').size() > 0
          && request.resource.data.version == get(/databases/$(database)/documents/friendGroups/$(group)/scores/$(request.resource.data.target)).data.get('vibesVersion','legacy')
          && request.resource.data.kind in ['happy','sad','party','fire','sun','love','wow','sleepy','strong','rocket','martian','distorted','laughing','crying','angry','thinking','wink','salute','grateful','melting','nerd','kiss','mogging']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && member(group,request.auth.uid) && (self(resource.data.reactor) || owner(group));
      }
    }
    match /solarOwnership/{uid} {
      allow read: if self(uid);
      allow delete: if self(uid) && groupData(resource.data.groupId).get('deletedAt',null) != null;
      allow create: if self(uid) && request.resource.data.keys().hasOnly(['owner','groupId','createdAt'])
        && request.resource.data.owner == uid && request.resource.data.groupId is string
        && getAfter(/databases/$(database)/documents/friendGroups/$(request.resource.data.groupId)).data.owner == uid
        && request.resource.data.createdAt == request.time;
    }
    match /groupDirectory/{group} {
      allow read: if signedIn();
      allow update: if owner(group) && groupData(group).get('deletedAt',null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','searchName'])
        && request.resource.data.name == groupData(group).name && request.resource.data.searchName == groupData(group).name.lower();
      allow delete: if owner(group) && groupData(group).get('deletedAt',null) != null;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['groupId','name','searchName','owner','ownerUsername','createdAt'])
        && request.resource.data.groupId == group && self(request.resource.data.owner)
        && request.resource.data.name == groupData(group).name && request.resource.data.searchName == groupData(group).name.lower()
        && request.resource.data.ownerUsername == groupData(group).ownerUsername && request.resource.data.createdAt == request.time;
    }
    match /groupMemberships/{uid}/groups/{group} {
      allow read: if self(uid);
      allow create: if mayAdmit(group,uid) && request.resource.data.keys().hasOnly(['groupId','groupName','owner','ownerUsername','joinedAt'])
        && request.resource.data.groupId == group && request.resource.data.groupName == groupData(group).name
        && request.resource.data.owner == groupData(group).owner && request.resource.data.ownerUsername == groupData(group).ownerUsername
        && request.resource.data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/friendGroups/$(group)/members/$(uid)).data.uid == uid;
      allow delete: if mayRemove(group,uid) || owner(group) && groupData(group).get('deletedAt',null) != null;
    }
    match /groupRequests/{id} {
      allow read,delete: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['groupId','groupName','owner','userId','username','kind','createdAt'])
        && id == request.resource.data.groupId+'~'+request.resource.data.userId
        && request.resource.data.owner == groupData(request.resource.data.groupId).owner && request.resource.data.groupName == groupData(request.resource.data.groupId).name
        && groupData(request.resource.data.groupId).get('deletedAt',null) == null
        && request.resource.data.userId != request.resource.data.owner && !member(request.resource.data.groupId,request.resource.data.userId)
        && request.resource.data.username == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.userId)).data.username
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'join' && self(request.resource.data.userId))
          || (request.resource.data.kind == 'invite' && owner(request.resource.data.groupId)
            && exists(/databases/$(database)/documents/friendships/$(request.auth.uid)/friends/$(request.resource.data.userId))));
    }
    match /socialPreferences/{uid} {
      allow read: if self(uid);
      allow create,update: if self(uid) && request.resource.data.keys().hasOnly(['primaryGroupId','updatedAt','planet','vibes','vibesVersion'])
        && validAppearance(request.resource.data)
        && (!request.resource.data.keys().hasAny(['primaryGroupId']) || (exists(/databases/$(database)/documents/socialPreferences/$(uid)) && request.resource.data.primaryGroupId == resource.data.get('primaryGroupId',''))
          || request.resource.data.primaryGroupId is string && existsAfter(/databases/$(database)/documents/friendGroups/$(request.resource.data.primaryGroupId)/members/$(uid)))
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{userId}/records/{recordId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function supportedId() { return recordId.matches('settings|day_[0-9]{4}-[0-9]{2}-[0-9]{2}|targets_[0-9]{4}-[0-9]{2}-[0-9]{2}|routine_[A-Za-z0-9_-]+'); }
      allow read: if owner();
      allow create, update: if owner() && supportedId()
        && request.resource.data.keys().hasOnly(['format', 'payload', 'updatedAt'])
        && request.resource.data.format == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 850000
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
